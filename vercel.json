{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "seed"
        }
      ],
      "destination": "/play.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "at"
        }
      ],
      "destination": "/play.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "hour"
        }
      ],
      "destination": "/play.html",
      "permanent": false
    },
    {
